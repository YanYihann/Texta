{
  "name": "texta",
  "version": "1.0.0",
  "description": "Bilingual IELTS vocabulary writing assistant with generation, study, and account workflows.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test:library": "node tests/library-api.cjs",
    "test:wechat": "node --test tests/wechat-auth.cjs",
    "test:context": "node tests/context-translation.cjs",
    "test:mixed": "node --test tests/mixed-generation.cjs",
    "test:bilingual": "node --test tests/bilingual-generation.cjs",
    "test:vocabulary": "node --test tests/vocabulary-details.cjs",
    "postinstall": "prisma generate",
    "ui:audit": "impeccable detect public --fast",
    "ui:audit:json": "impeccable detect public --fast --json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test:billing": "node --test tests/billing.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "prisma": "^6.13.0"
  },
  "devDependencies": {
    "impeccable": "^2.0.7"
  }
}
