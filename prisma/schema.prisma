// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id
  email        String @unique
  name         String
  passwordHash String
  role         String @default("user")
  plan         String @default("free")
  permanentPlan String @default("free")
  planExpiresAt DateTime?
  createdAt    String
}

model PaymentOrder {
  id           String @id
  userId       String
  product      String
  amountFen    Int
  provider     String
  status       String @default("pending")
  requestKey   String
  tradeNo      String? @unique
  providerSessionId String?
  checkoutUrl String?
  paymentProof String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  paidAt       DateTime?

  @@unique([userId, requestKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Session {
  token     String @id
  userId    String
  expiresAt BigInt
  createdAt BigInt

  @@index([userId])
}

model UsageDaily {
  id      String @id @default(cuid())
  userId  String
  dateKey String
  used    Int    @default(0)

  @@unique([userId, dateKey])
  @@index([dateKey])
}

model UsageLog {
  id          String @id @default(cuid())
  userId      String
  usedAt      String
  dateKey     String
  hourKey     String
  periodLabel String

  @@index([userId, usedAt])
  @@index([hourKey])
}

model VipRequest {
  id            String @id
  userId        String
  userEmail     String
  payerName     String
  amount        String
  paidAt        String
  proofCode     String
  proofImageUrl String
  note          String
  status        String
  createdAt     String
  reviewedAt    String
  reviewerId    String
  reviewNote    String

  @@index([userId, status])
}

model LibraryFolder {
  id String @id
  userId String
  name String
  createdAt String
  updatedAt String
  deletedAt String @default("")

  @@index([userId, updatedAt])
}

model FavoriteArticle {
  id           String @id
  userId       String
  title        String
  folderId     String @default("")
  deletedAt    String @default("")
  savedAt      String
  words        Json
  article      String
  lexicon      Json
  paragraphsEn Json
  paragraphsZh Json
  alignment    Json
  missing      Json
  createdAt    String
  updatedAt    String

  @@index([userId, updatedAt])
  @@index([userId, savedAt])
}

model NotebookEntry {
  id           String @id @default(cuid())
  userId       String
  wordKey      String
  word         String
  pos          String
  senses       Json
  collocations Json
  synonyms     Json
  antonyms     Json
  wordFormation String
  sourceArticle Json @default("null")
  deletedAt    String @default("")
  createdAt    String
  updatedAt    String

  @@unique([userId, wordKey])
  @@index([userId, updatedAt])
}

model UserVocabPref {
  id        String @id @default(cuid())
  userId    String
  wordKey   String
  word      String
  mastery   String
  createdAt String
  updatedAt String

  @@unique([userId, wordKey])
  @@index([userId, updatedAt])
}
