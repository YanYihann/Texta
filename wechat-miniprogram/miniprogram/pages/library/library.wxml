<view class="theme-root" style="{{themeStyle}}">
<view class="screen">
  <view class="row"><view class="page-title">我的资料库</view><button class="plain small" bindtap="sync" disabled="{{!loggedIn || syncing}}" loading="{{syncing}}">同步</button></view>
  <view class="muted">{{loggedIn ? syncText : '登录后查看你的收藏和生词本。'}}</view>
  <view wx:if="{{!loggedIn}}" class="section empty panel"><view class="section-title">让学习资料跟着你</view><view class="muted">使用 Texta 账号同步网页中的收藏和生词。</view><button class="primary" bindtap="login">登录 Texta</button></view>
  <block wx:else>
    <view class="section tabs"><button class="tab {{tab === 'favorites' ? 'active' : ''}}" data-tab="favorites" bindtap="changeTab">收藏文章</button><button class="tab {{tab === 'notebook' ? 'active' : ''}}" data-tab="notebook" bindtap="changeTab">生词本</button><button class="tab {{tab === 'history' ? 'active' : ''}}" data-tab="history" bindtap="changeTab">本机历史</button></view>
    <input class="field search" placeholder="{{tab === 'notebook' ? '搜索单词或释义' : '搜索标题或目标词'}}" placeholder-class="placeholder" placeholder-style="color:{{themeMuted}}" value="{{query}}" bindinput="search" />
    <view wx:if="{{tab === 'notebook'}}" class="filters"><button class="small {{category === 'unknown' ? 'secondary' : 'plain'}}" data-category="unknown" bindtap="changeCategory">未掌握</button><button class="small {{category === 'mastered' ? 'secondary' : 'plain'}}" data-category="mastered" bindtap="changeCategory">已掌握</button><button class="small {{category === 'all' ? 'secondary' : 'plain'}}" data-category="all" bindtap="changeCategory">全部</button></view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <block wx:if="{{tab === 'favorites'}}"><view wx:for="{{favorites}}" wx:key="id" class="list-row"><view bindtap="openArticle" data-id="{{item.id}}" class="article-tap" role="button"><view class="list-title">{{item.title}}</view><view class="list-meta">{{item.date}} · {{item.count}} 个词 · {{item.mode}}</view></view><button class="plain small remove" bindtap="remove" data-type="article" data-id="{{item.id}}">取消收藏</button></view><view wx:if="{{!favorites.length}}" class="empty"><view class="section-title">{{query ? '没有匹配的文章' : '收藏值得再读的文章'}}</view><view class="muted">{{query ? '试试其他标题或目标词。' : '在阅读页点击收藏，之后就能在这里找到。'}}</view><button wx:if="{{!query}}" class="secondary" bindtap="generate">生成第一篇文章</button></view></block>
    <block wx:elif="{{tab === 'notebook'}}"><view wx:for="{{notebook}}" wx:key="key" class="list-row"><view bindtap="openWord" data-key="{{item.key}}" class="article-tap" role="button"><view class="row"><text class="notebook-word">{{item.word}}</text><text class="tag" wx:if="{{item.mastered}}">已掌握</text></view><view class="list-meta">{{item.pos}} {{item.meaning}}</view></view><button class="plain small remove" bindtap="remove" data-type="word" data-id="{{item.key}}">移除</button></view><view wx:if="{{!notebook.length}}" class="empty"><view class="section-title">{{query ? '没有匹配的单词' : '这里还没有单词'}}</view><view class="muted">阅读时点击高亮词，加入生词本；已掌握的词会移到对应分类。</view></view><button wx:if="{{notebook.length}}" class="secondary full section" bindtap="reviewWords">用这些词生成复习短文</button></block>
    <block wx:else><view class="notice">最近 30 篇生成记录保存在本机；收藏文章可以同步到其他设备。</view><view wx:for="{{history}}" wx:key="id" class="list-row article-tap" bindtap="openArticle" data-id="{{item.id}}" role="button"><view class="list-title">{{item.title}}</view><view class="list-meta">{{item.date}} · {{item.count}} 个词 · {{item.mode}}</view></view><view wx:if="{{!history.length}}" class="empty"><view class="section-title">{{query ? '没有匹配的记录' : '还没有生成记录'}}</view><button class="secondary" bindtap="generate">去生成文章</button></view></block>
  </block>
</view>
<word-sheet open="{{wordOpen}}" entry="{{entry}}" article="{{sourceArticle}}" bind:close="closeWord" bind:change="refresh" bind:source="openSource" />

</view>
