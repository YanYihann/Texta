.overlay { position: fixed; inset: 0; z-index: 100; }
.shade { position: absolute; inset: 0; background: #19251f66; }
.sheet { position: absolute; bottom: 0; left: 0; right: 0; background: var(--panel); border-radius: 28rpx 28rpx 0 0; padding: 24rpx 32rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.sheet-header { margin-bottom: 16rpx; }
.word { font-family: Georgia, serif; font-size: 48rpx; font-weight: 600; overflow-wrap: break-word; flex: 1; min-width: 0; line-height: 1.3; }
.sheet-body { height: 56vh; }
.ipa { color: var(--muted); font-size: 28rpx; margin-top: 8rpx; }
.context { background: var(--soft); padding: 20rpx; margin-top: 24rpx; border-radius: 16rpx; }
.label { display: block; color: var(--muted); font-size: 25rpx; margin-bottom: 10rpx; }
.definition-section { margin-top: 26rpx; line-height: 1.7; }
.sheet-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.sheet-actions button { flex: 1; padding: 0 14rpx; font-size: 28rpx; }
